# Data layers
# RAW JSON is the source of truth for daily Grok feeds — MUST be versioned.
# Do NOT ignore data/raw/**/*.json
data/processed/**/*.parquet
!data/processed/.gitkeep
data/historical/**/*.parquet
!data/historical/.gitkeep

# Reports (regenerable)
reports/daily/**/*
!reports/daily/.gitkeep
reports/archive/**/*
!reports/archive/.gitkeep

